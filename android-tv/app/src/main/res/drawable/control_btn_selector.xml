<?xml version="1.0" encoding="utf-8"?>
<!-- State list drawable for control buttons: focused/selected = rose-gold, normal = translucent dark -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"  android:drawable="@drawable/control_btn_focused" />
    <item android:state_selected="true" android:drawable="@drawable/control_btn_focused" />
    <item android:state_pressed="true"  android:drawable="@drawable/control_btn_focused" />
    <item                               android:drawable="@drawable/control_btn_normal" />
</selector>
