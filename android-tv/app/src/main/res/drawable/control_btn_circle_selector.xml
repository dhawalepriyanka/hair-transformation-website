<?xml version="1.0" encoding="utf-8"?>
<!-- Selector for small floating circular control buttons -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"  android:drawable="@drawable/control_btn_circle_focused" />
    <item android:state_selected="true" android:drawable="@drawable/control_btn_circle_focused" />
    <item android:state_pressed="true"  android:drawable="@drawable/control_btn_circle_focused" />
    <item                               android:drawable="@drawable/control_btn_circle_normal" />
</selector>
